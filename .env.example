# Salin file ini menjadi .env lalu isi nilainya

# Database Configuration (MySQL lokal: XAMPP/Laragon)
# Jika DATABASE_URL diisi, aplikasi memakai PostgreSQL dan DB_* di bawah diabaikan.
# Di Vercel, DATABASE_URL otomatis ditambahkan oleh integrasi Neon.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_SERVER=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=webdailyjournal
# DB_PORT=3306

# Google Gemini AI Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Simpan session login di database (WAJIB di Vercel). Kosongkan untuk session file biasa.
# Untuk MySQL jalankan dulu migrations/002_sessions.sql
# SESSION_DRIVER=database

# Token Vercel Blob untuk upload gambar (otomatis ada setelah Blob store dihubungkan ke project).
# Jika kosong, gambar disimpan di folder img/
# BLOB_READ_WRITE_TOKEN=

# (Opsional) Urutan model Gemini yang dicoba, dipisah koma
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-flash-latest,gemini-2.5-flash

# (Opsional) Path CA bundle untuk cURL, dibutuhkan XAMPP di Windows jika muncul
# error "SSL certificate problem". Download cacert.pem dari https://curl.se/ca/cacert.pem
# CURL_CA_BUNDLE=C:/xampp/php/extras/ssl/cacert.pem
