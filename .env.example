# Salin file ini menjadi .env lalu isi nilainya

# Database Configuration
DB_SERVER=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=webdailyjournal
# DB_PORT=3306

# Google Gemini AI Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# (Opsional) Urutan model Gemini yang dicoba, dipisah koma
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-flash-latest,gemini-2.5-flash

# (Opsional) Path CA bundle untuk cURL, dibutuhkan XAMPP di Windows jika muncul
# error "SSL certificate problem". Download cacert.pem dari https://curl.se/ca/cacert.pem
# CURL_CA_BUNDLE=C:/xampp/php/extras/ssl/cacert.pem
